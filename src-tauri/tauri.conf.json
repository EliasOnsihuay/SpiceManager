{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpiceManager",
  "version": "0.1.3",
  "identifier": "com.kodhu.spicemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpiceManager",
        "width": 1160,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Kodhu Technologies",
    "copyright": "Copyright (c) 2026 Elias Onsihuay / Kodhu Technologies",
    "category": "Utility",
    "shortDescription": "Third-party utility for managing Spotify + Spicetify setups.",
    "longDescription": "SpiceManager is a third-party desktop utility for detecting, repairing, validating, and maintaining Spotify + Spicetify setups."
  }
}
