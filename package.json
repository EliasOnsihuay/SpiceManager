{
  "name": "spicemanager",
  "version": "0.1.1",
  "private": true,
  "description": "Third-party utility for managing Spotify + Spicetify setups.",
  "author": "Elias Onsihuay / Kodhu Technologies",
  "repository": {
    "type": "git",
    "url": "https://github.com/EliasOnsihuay/SpiceManager.git"
  },
  "homepage": "https://github.com/EliasOnsihuay/SpiceManager",
  "bugs": {
    "url": "https://github.com/EliasOnsihuay/SpiceManager/issues"
  },
  "keywords": [
    "spicemanager",
    "spicetify",
    "spotify",
    "tauri",
    "desktop"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && npm run check:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
